# Copy to .env and fill in. Never commit the real .env.

# Kalshi auth is API-key-id + RSA private key (RSA-PSS signing over each
# request). See kalshi/client.py's sign_kalshi_request().

# --- Prod (market data + Stage 3's WS handshake — detection only, no orders) ---
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Required in addition to execution.target: prod and execution.prod_enabled:
# true. The expected ID safeguard prevents accidentally trading a different
# production account. The scanner also requires --confirm-live-trading.
# KALSHI_PROD_TRADING_ENABLED=false
# KALSHI_EXPECTED_PROD_API_KEY_ID=
# Required for production. Receives incident JSON via HTTPS POST.
# KALSHI_ALERT_WEBHOOK_URL=

# Native Telegram alerts. Create a bot with @BotFather, message it once,
# then obtain the numeric chat id from getUpdates. Configure both together.
# These may be used instead of KALSHI_ALERT_WEBHOOK_URL for production.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Demo (separate Kalshi account — execution/executor.py places orders
# here, never against prod). Only used when execution.enabled: true in
# config/settings.yaml. Fund the demo account's paper balance via Kalshi's
# demo UI first, or every order will be rejected with insufficient_balance. ---
# KALSHI_DEMO_API_KEY_ID=
# KALSHI_DEMO_PRIVATE_KEY_PATH=./secrets/kalshi_demo_private_key.pem
